# Copy to .env in the repo root and fill in. The Makefile exports these to every command.
# Get a key at https://console.anthropic.com. Add about $5 of credit; the whole 2-week build should cost less than that.
ANTHROPIC_API_KEY= sk-ant-usr...
CARDO_MODEL=claude-haiku-5-5
DATABASE_URL=postgres://cardo:cardo@localhost:5432/cardo

# Day 4+: Langfuse Cloud (free tier) for tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
